NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
MONGODB_URI=mongodb://localhost:27017/gym4me?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_PROVIDER=console
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=gym4meotp
KAVENEGAR_SENDER=
KAVENEGAR_TEMPLATE_BOOKING_CONFIRMED=gym4mebookingconfirmed
KAVENEGAR_TEMPLATE_BOOKING_REMINDER=gym4mebookingreminder
KAVENEGAR_TEMPLATE_BOOKING_CANCELLED=gym4mebookingcancelled
KAVENEGAR_TEMPLATE_BOOKING_RESCHEDULED=gym4mebookingrescheduled
KAVENEGAR_TEMPLATE_WAITLIST_AVAILABLE=gym4mewaitlist
KAVENEGAR_TEMPLATE_PAYMENT_FAILED=gym4mepaymentfailed
NOTIFICATION_PROVIDER=console
PUSH_PROVIDER=console
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_TOKEN=
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Store multiline private keys in the secret manager; escaped \\n is supported.
FCM_PRIVATE_KEY=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.gym4me.app
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
APNS_ENABLED=false
BOOKING_REMINDER_MINUTES=120
WORKER_HEALTH_HOST=0.0.0.0
WORKER_HEALTH_PORT=4001
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083
TRUST_PROXY=false
SWAGGER_ENABLED=true
METRICS_TOKEN=
REQUEST_BODY_LIMIT_BYTES=1048576
RATE_LIMIT_PER_MINUTE=120
PUBLIC_API_URL=http://localhost:4000/api/v1
UPLOAD_STORAGE_PATH=./var/uploads
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_BUSINESS_PANEL_URL=http://localhost:8083
