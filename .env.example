# Used by root docker-compose.yml (api service). Copy to .env and change secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30
SMS_PROVIDER=mock
KYC_PROVIDER=mock

