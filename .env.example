# Used by root docker-compose.yml (api service). Copy to .env and set strong secrets.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_PASSWORD_RESET_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

# Comma-separated browser origins for production. Empty = reflective only in non-prod.
CORS_ORIGINS=
ENABLE_SWAGGER=false
DEBUG_MODE=false

SMS_PROVIDER=mock
PAYMENT_PROVIDER=mock
# mock | finnotech (Shahkar via Finnotech aggregator)
KYC_PROVIDER=mock
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_CLIENT_NATIONAL_ID=

# Optional Android release overrides for docker/android builds
# GYM4ME_VERSION_CODE=1
# GYM4ME_VERSION_NAME=1.0.0
