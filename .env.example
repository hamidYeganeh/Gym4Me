# Used by root docker-compose.yml (api service). Copy to .env and set strong secrets.
NODE_ENV=development
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_PASSWORD_RESET_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30
BOOKING_PAYMENT_TTL_MINUTES=15
REFERRAL_REWARD_AMOUNT=50000

# Comma-separated browser origins for production. Empty = reflective only in non-prod.
CORS_ORIGINS=
API_BASE_URL=http://localhost:8088
ENABLE_SWAGGER=false
# Required for local mock SMS; production rejects debug mode.
DEBUG_MODE=true

# mock | kavenegar
SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
KAVENEGAR_INVITE_TEMPLATE=
KAVENEGAR_SENDER=

# mock | zarinpal
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# mock | fcm
PUSH_PROVIDER=mock
FCM_SERVICE_ACCOUNT=

# mock | finnotech (Shahkar via Finnotech aggregator)
KYC_PROVIDER=mock
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_CLIENT_NATIONAL_ID=

SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_WORKING_HOURS=

# Optional Android/Docker override. Prefer apps/mobile/.env.[mode] for local UI:
#   development → http://192.168.3.106:8088/api/v1
#   production  → https://api.gym4me.ir/api/v1
NEXT_PUBLIC_API_BASE_URL=http://192.168.3.106:8088/api/v1

# Optional Android release overrides for Docker/Gradle builds.
# GYM4ME_VERSION_CODE=1
# GYM4ME_VERSION_NAME=1.0
# GYM4ME_UPLOAD_STORE_FILE=/secrets/upload-keystore.jks
# GYM4ME_UPLOAD_STORE_PASSWORD=
# GYM4ME_UPLOAD_KEY_ALIAS=upload
# GYM4ME_UPLOAD_KEY_PASSWORD=
# Public store destinations used by the website download CTAs. Buttons stay
# disabled until the corresponding production listing is available.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
