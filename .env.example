# Used by root docker-compose.yml (api service). Copy to .env and change secrets.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30
SMS_PROVIDER=mock
# mock | finnotech (Shahkar via Finnotech aggregator)
KYC_PROVIDER=mock
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_CLIENT_NATIONAL_ID=

# Optional Android release overrides for docker/android builds
# GYM4ME_VERSION_CODE=1
# GYM4ME_VERSION_NAME=1.0.0
