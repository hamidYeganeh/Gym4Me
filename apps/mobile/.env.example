# Frontend public config (no secrets).
#
# Load order (Next.js):
#   .env                  shared defaults (optional)
#   .env.local            local overrides (gitignored) — copy from .env.local.example
#   .env.[mode]           .env.development | .env.production (committed)
#   .env.[mode].local     mode-specific local overrides (gitignored)
#
# Development → http://192.168.3.106:8088/api/v1
# Production  → https://api.gym4me.ir/api/v1

# Public API URL embedded in the Next.js/Capacitor bundle (must include /api/v1).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://10.191.88.178:8088/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://192.168.3.106:8088/api/v1

# Explicit local-only fixture mode. Production builds always force this off.
NEXT_PUBLIC_DEMO_MODE=false

# Standalone web panel for club-owner operations.
NEXT_PUBLIC_BUSINESS_PANEL_URL=http://localhost:8083
