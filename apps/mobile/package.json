{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 8081",
    "build": "next build",
    "start": "next start --port 8081",
    "lint": "eslint",
    "check-types": "next typegen && tsc --noEmit",
    "cap:sync": "bash scripts/cap-prepare.sh",
    "cap:sync:android": "bash scripts/cap-prepare.sh android",
    "cap:sync:ios": "bash scripts/cap-prepare.sh ios",
    "cap:assets": "node scripts/generate-capacitor-assets.mjs",
    "cap:copy": "npx cap copy",
    "cap:update": "npx cap update",
    "cap:doctor": "npx cap doctor",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "android:apk": "npm run cap:sync:android && bash scripts/android-build.sh apk:debug",
    "android:apk:release": "npm run cap:sync:android && bash scripts/android-build.sh apk:release",
    "android:aab": "npm run cap:sync:android && bash scripts/android-build.sh aab",
    "android:keystore": "bash scripts/android-keystore.sh",
    "android:open": "npm run cap:open:android",
    "ios:sim": "npm run cap:sync && bash scripts/ios-build.sh simulator",
    "ios:archive": "npm run cap:sync && bash scripts/ios-build.sh archive",
    "ios:ipa": "npm run cap:sync && bash scripts/ios-build.sh ipa",
    "ios:open": "npm run cap:open:ios"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^9.1.2",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/push-notifications": "^7.0.7",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-health": "^7.2.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@heroui/react": "^3.0.0",
    "@heroui/styles": "^3.0.0",
    "@hookform/resolvers": "^5.7.1",
    "@internationalized/date": "^3.12.3",
    "@number-flow/react": "^0.6.2",
    "@repo/api": "*",
    "@repo/fonts": "*",
    "@repo/i18n": "*",
    "@repo/icons": "*",
    "@repo/theme": "*",
    "@repo/ui": "*",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "isomorphic-dompurify": "^3.22.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "next-intl": "^4.3.4",
    "react": "19.2.4",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.85.0",
    "react-use-measure": "^2.1.7",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.8",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
