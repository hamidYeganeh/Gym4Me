// Gym4Me — core domain schema
// Roles: athlete, coach, club_owner, club_staff, admin

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// Identity & RBAC
// ─────────────────────────────────────────────

enum Role {
  ATHLETE
  COACH
  CLUB_OWNER
  CLUB_STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING_VERIFICATION
  DELETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id           String     @id @default(cuid())
  phone        String?    @unique
  email        String?    @unique
  passwordHash String
  fullName     String
  avatarUrl    String?
  gender       Gender?
  birthDate    DateTime?
  status       UserStatus @default(ACTIVE)
  roles        Role[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athleteProfile AthleteProfile?
  coachProfile   CoachProfile?
  refreshTokens  RefreshToken[]
  ownedClubs     Club[]          @relation("ClubOwner")
  staffPositions StaffMember[]

  documents             Document[]
  bookings              Booking[]              @relation("Booker")
  bookingAttendances    BookingAttendee[]
  platformSubscriptions PlatformSubscription[]
  wallet                Wallet?
  payments              Payment[]
  notifications         Notification[]

  followers      Follow[]        @relation("FollowingUser")
  following      Follow[]        @relation("Follower")
  posts          Post[]
  postLikes      PostLike[]
  postComments   PostComment[]
  savedPosts     SavedPost[]
  reviews        Review[]
  contentReports ContentReport[]
  supportTickets SupportTicket[]
  sentMessages     Message[] @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")

  auditLogs              AuditLog[]             @relation("AuditActor")
  impersonationsAsAdmin  ImpersonationSession[] @relation("ImpersonatorAdmin")
  impersonationsAsTarget ImpersonationSession[] @relation("ImpersonationTarget")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Admin-manageable permission catalog for club staff
model PermissionDefinition {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "bookings.create", "finance.read"
  title       String
  description String?
  isActive    Boolean @default(true)
}

// ─────────────────────────────────────────────
// Profiles
// ─────────────────────────────────────────────

enum VerificationStatus {
  UNSUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio      String?
  levelId  String?
  level    AthleteLevel? @relation(fields: [levelId], references: [id])
  heightCm Float?

  // privacy defaults for sensitive data
  metricsPrivacy Privacy @default(PRIVATE)
  photosPrivacy  Privacy @default(PRIVATE)

  sports          AthleteSport[]
  goals           AthleteGoal[]
  metricEntries   MetricEntry[]
  progressPhotos  ProgressPhoto[]
  personalRecords PersonalRecord[]
  workoutLogs     WorkoutLog[]
  programs        Program[]        @relation("ProgramAthlete")
  clubMemberships ClubMembership[]
  coachLinks      CoachStudent[]
  classEnrollments ClassEnrollment[]
  entryTickets    EntryTicket[]
  groupMemberships StudentGroupMember[]
  supplementPlans SupplementPlan[]
}

model CoachProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio             String?
  headline        String?
  experienceYears Int?
  verification    VerificationStatus @default(UNSUBMITTED)
  verifiedAt      DateTime?
  serviceCityId   String?
  serviceCity     City?              @relation(fields: [serviceCityId], references: [id])

  sports           CoachSport[]
  specialties      CoachSpecialtyLink[]
  services         CoachService[]
  availabilities   CoachAvailability[]
  clubAffiliations CoachClubAffiliation[]
  students         CoachStudent[]
  studentGroups    StudentGroup[]
  programs         Program[]              @relation("ProgramCoach")
  customExercises  Exercise[]             @relation("ExerciseCreator")
  groupClasses     GroupClass[]
  coachBookings    Booking[]              @relation("BookingCoach")
  settlements      Settlement[]           @relation("SettlementCoach")
  supplementPlans  SupplementPlan[]
}

model Document {
  id         String             @id @default(cuid())
  ownerId    String
  owner      User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clubId     String?
  club       Club?              @relation(fields: [clubId], references: [id])
  typeId     String
  type       DocumentType       @relation(fields: [typeId], references: [id])
  fileUrl    String
  title      String?
  status     VerificationStatus @default(PENDING)
  reviewNote String?
  createdAt  DateTime           @default(now())
  reviewedAt DateTime?
}

// ─────────────────────────────────────────────
// Admin-managed taxonomies (dynamic data)
// ─────────────────────────────────────────────

enum TaxonomyStatus {
  PENDING // user-created, awaiting admin approval
  APPROVED
  REJECTED
}

model Sport {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String?
  parent   Sport?  @relation("SportTree", fields: [parentId], references: [id])
  children Sport[] @relation("SportTree")
  iconUrl  String?
  isActive Boolean @default(true)

  athleteLinks AthleteSport[]
  coachLinks   CoachSport[]
  clubLinks    ClubSport[]
  exercises    Exercise[]
  metricTypes  MetricType[]
  sessions     ClubSession[]
  classes      GroupClass[]
  membershipPlans ClubMembershipPlan[]
}

model CoachSpecialty {
  id       String               @id @default(cuid())
  name     String               @unique
  isActive Boolean              @default(true)
  coaches  CoachSpecialtyLink[]
}

model AthleteLevel {
  id       String           @id @default(cuid())
  name     String           @unique
  order    Int              @default(0)
  isActive Boolean          @default(true)
  athletes AthleteProfile[]
}

// Admin-defined goal templates (athletes can also create custom goals)
model GoalType {
  id       String        @id @default(cuid())
  name     String        @unique
  iconUrl  String?
  isActive Boolean       @default(true)
  goals    AthleteGoal[]
}

model Amenity {
  id       String        @id @default(cuid())
  name     String        @unique
  iconUrl  String?
  isActive Boolean       @default(true)
  clubs    ClubAmenity[]
}

model SpaceType {
  id       String  @id @default(cuid())
  name     String  @unique // e.g. زمین فوتبال، سالن بدنسازی، استخر
  isActive Boolean @default(true)
  spaces   Space[]
}

model EquipmentItem {
  id       String          @id @default(cuid())
  name     String          @unique
  isActive Boolean         @default(true)
  clubs    ClubEquipment[]
  exercises ExerciseEquipment[]
}

model Muscle {
  id        String           @id @default(cuid())
  name      String           @unique
  bodyPart  String?
  isActive  Boolean          @default(true)
  exercises ExerciseMuscle[]
}

model FoodItem {
  id            String  @id @default(cuid())
  name          String  @unique
  caloriesPer100 Float?
  proteinPer100  Float?
  carbsPer100    Float?
  fatPer100      Float?
  isActive      Boolean @default(true)
}

model MeasurementUnit {
  id          String       @id @default(cuid())
  name        String       @unique // کیلوگرم
  symbol      String // kg
  isActive    Boolean      @default(true)
  metricTypes MetricType[]
}

model CancellationReason {
  id       String   @id @default(cuid())
  title    String   @unique
  scope    String // booking | refund | membership
  isActive Boolean  @default(true)
  refunds  Refund[]
}

model DocumentType {
  id        String     @id @default(cuid())
  name      String     @unique // کارت مربیگری، مجوز باشگاه، ...
  audience  Role
  isActive  Boolean    @default(true)
  documents Document[]
}

model City {
  id        String       @id @default(cuid())
  name      String
  province  String
  isActive  Boolean      @default(true)
  districts District[]
  branches  ClubBranch[]
  coaches   CoachProfile[]

  @@unique([name, province])
}

model District {
  id       String       @id @default(cuid())
  name     String
  cityId   String
  city     City         @relation(fields: [cityId], references: [id], onDelete: Cascade)
  branches ClubBranch[]

  @@unique([cityId, name])
}

// Extensible progress metrics (per-sport when needed)
model MetricType {
  id        String           @id @default(cuid())
  key       String           @unique // weight, heart_rate, hydration, ...
  name      String
  unitId    String?
  unit      MeasurementUnit? @relation(fields: [unitId], references: [id])
  sportId   String? // sport-specific metric when set
  sport     Sport?           @relation(fields: [sportId], references: [id])
  valueKind String           @default("number") // number | pair (e.g. blood pressure) | text
  isActive  Boolean          @default(true)
  entries   MetricEntry[]
}

// ─────────────────────────────────────────────
// Clubs, branches, spaces, sessions
// ─────────────────────────────────────────────

enum GenderPolicy {
  MEN_ONLY
  WOMEN_ONLY
  MIXED
}

model Club {
  id           String             @id @default(cuid())
  ownerId      String
  owner        User               @relation("ClubOwner", fields: [ownerId], references: [id])
  name         String
  slug         String             @unique
  description  String?
  logoUrl      String?
  rules        String?
  genderPolicy GenderPolicy       @default(MIXED)
  verification VerificationStatus @default(PENDING)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  branches        ClubBranch[]
  staff           StaffMember[]
  documents       Document[]
  membershipPlans ClubMembershipPlan[]
  announcements   ClubAnnouncement[]
  coachAffiliations CoachClubAffiliation[]
  cancellationPolicies CancellationPolicy[]
  discountCodes   DiscountCode[]
  followers       Follow[]             @relation("FollowingClub")
  reviews         Review[]             @relation("ReviewClub")
  settlements     Settlement[]         @relation("SettlementClub")
}

model ClubBranch {
  id         String    @id @default(cuid())
  clubId     String
  club       Club      @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name       String
  cityId     String?
  city       City?     @relation(fields: [cityId], references: [id])
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])
  address    String?
  latitude   Float?
  longitude  Float?
  phone      String?
  images     String[]
  // {"sat":[{"open":"06:00","close":"23:00"}],...} + holidays as ISO dates
  workingHours Json?
  holidays     DateTime[]
  isActive     Boolean    @default(true)

  amenities   ClubAmenity[]
  sports      ClubSport[]
  spaces      Space[]
  sessions    ClubSession[]
  classes     GroupClass[]
  equipment   ClubEquipment[]
  staff       StaffMember[]
  memberships ClubMembership[]
  membershipPlanLinks ClubMembershipPlanBranch[]
  checkIns    MembershipCheckIn[]
  tickets     EntryTicket[]
}

model ClubAmenity {
  branchId  String
  branch    ClubBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  amenityId String
  amenity   Amenity    @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([branchId, amenityId])
}

model ClubSport {
  branchId String
  branch   ClubBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sportId  String
  sport    Sport      @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([branchId, sportId])
}

model ClubEquipment {
  id          String        @id @default(cuid())
  branchId    String
  branch      ClubBranch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   EquipmentItem @relation(fields: [equipmentId], references: [id])
  quantity    Int           @default(1)
  note        String?

  @@unique([branchId, equipmentId])
}

// Bookable physical resource (زمین / سالن / فضا) — independent calendar & capacity
model Space {
  id          String     @id @default(cuid())
  branchId    String
  branch      ClubBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  typeId      String
  type        SpaceType  @relation(fields: [typeId], references: [id])
  name        String
  capacity    Int        @default(1)
  hourlyPrice Decimal?   @db.Decimal(12, 0)
  images      String[]
  isActive    Boolean    @default(true)

  sessions ClubSession[]
  bookings Booking[]     @relation("BookingSpace")
}

// سانس: recurring scheduled slot with its own capacity
model ClubSession {
  id           String       @id @default(cuid())
  branchId     String
  branch       ClubBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  spaceId      String?
  space        Space?       @relation(fields: [spaceId], references: [id])
  sportId      String?
  sport        Sport?       @relation(fields: [sportId], references: [id])
  title        String
  weekday      Int // 0=Saturday ... 6=Friday
  startTime    String // "HH:mm"
  endTime      String
  capacity     Int
  price        Decimal?     @db.Decimal(12, 0)
  genderPolicy GenderPolicy @default(MIXED)
  isActive     Boolean      @default(true)

  bookings Booking[] @relation("BookingSession")
}

// کلاس گروهی with a coach
model GroupClass {
  id        String       @id @default(cuid())
  branchId  String
  branch    ClubBranch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  coachId   String?
  coach     CoachProfile? @relation(fields: [coachId], references: [id])
  sportId   String?
  sport     Sport?       @relation(fields: [sportId], references: [id])
  title     String
  description String?
  capacity  Int
  price     Decimal      @db.Decimal(12, 0)
  startDate DateTime
  endDate   DateTime?
  // recurring schedule: [{"weekday":0,"start":"18:00","end":"19:30"}]
  schedule  Json
  isActive  Boolean      @default(true)

  enrollments ClassEnrollment[]
  bookings    Booking[]         @relation("BookingClass")
}

model ClassEnrollment {
  id        String         @id @default(cuid())
  classId   String
  class     GroupClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  status    String         @default("active") // active | cancelled | completed
  createdAt DateTime       @default(now())

  @@unique([classId, athleteId])
}

model StaffMember {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId      String
  club        Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)
  branchId    String?
  branch      ClubBranch? @relation(fields: [branchId], references: [id])
  title       String // پذیرش، حسابدار، ...
  // permission keys from PermissionDefinition, granted by club owner
  permissions String[]
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  leaveRequests StaffLeaveRequest[]

  @@unique([userId, clubId])
}

model StaffLeaveRequest {
  id       String      @id @default(cuid())
  staffId  String
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  kind     String // leave | shift_change
  fromDate DateTime
  toDate   DateTime
  note     String?
  status   String      @default("pending") // pending | approved | rejected
  createdAt DateTime   @default(now())
}

model ClubAnnouncement {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  title     String
  body      String
  audience  String   @default("members") // members | all
  createdAt DateTime @default(now())
}

model CancellationPolicy {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name   String
  // tiers: [{"hoursBefore":24,"refundPercent":100},{"hoursBefore":6,"refundPercent":50}]
  tiers  Json
  isDefault Boolean @default(false)
}

// ─────────────────────────────────────────────
// Coach services, availability, students
// ─────────────────────────────────────────────

enum ServiceMode {
  IN_PERSON
  ONLINE
  GROUP
}

model CoachService {
  id          String       @id @default(cuid())
  coachId     String
  coach       CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  title       String
  mode        ServiceMode
  durationMin Int          @default(60)
  price       Decimal      @db.Decimal(12, 0)
  description String?
  isActive    Boolean      @default(true)

  bookings Booking[] @relation("BookingCoachService")
}

model CoachAvailability {
  id        String       @id @default(cuid())
  coachId   String
  coach     CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  weekday   Int
  startTime String
  endTime   String
  isActive  Boolean      @default(true)

  @@index([coachId, weekday])
}

model CoachClubAffiliation {
  id      String       @id @default(cuid())
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clubId  String
  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  role    String       @default("coach") // coach | member
  status  String       @default("pending") // pending | active | ended

  @@unique([coachId, clubId])
}

model CoachStudent {
  id        String         @id @default(cuid())
  coachId   String
  coach     CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  status    String         @default("pending") // pending | active | ended
  startedAt DateTime       @default(now())
  endedAt   DateTime?

  @@unique([coachId, athleteId])
}

model StudentGroup {
  id      String       @id @default(cuid())
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  name    String

  members StudentGroupMember[]
}

model StudentGroupMember {
  groupId   String
  group     StudentGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@id([groupId, athleteId])
}

// ─────────────────────────────────────────────
// Athlete sport/goal links
// ─────────────────────────────────────────────

model AthleteSport {
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sportId   String
  sport     Sport          @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([athleteId, sportId])
}

model CoachSport {
  coachId String
  coach   CoachProfile @relation(fields: [coachId], references: [id], onDelete: Cascade)
  sportId String
  sport   Sport        @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@id([coachId, sportId])
}

model CoachSpecialtyLink {
  coachId     String
  coach       CoachProfile   @relation(fields: [coachId], references: [id], onDelete: Cascade)
  specialtyId String
  specialty   CoachSpecialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([coachId, specialtyId])
}

// goalTypeId set → admin-defined goal; customTitle set → athlete-defined
model AthleteGoal {
  id          String         @id @default(cuid())
  athleteId   String
  athlete     AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  goalTypeId  String?
  goalType    GoalType?      @relation(fields: [goalTypeId], references: [id])
  customTitle String?
  targetValue Float?
  targetDate  DateTime?
  status      String         @default("active") // active | achieved | abandoned
  createdAt   DateTime       @default(now())
}

// ─────────────────────────────────────────────
// Booking (independent time inventory per resource)
// ─────────────────────────────────────────────

enum BookingType {
  SPACE // رزرو زمین / سالن
  CLUB_SESSION // رزرو سانس
  COACH_SESSION // جلسه خصوصی مربی (حضوری یا آنلاین)
  GROUP_CLASS // کلاس گروهی
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id       String      @id @default(cuid())
  type     BookingType
  bookerId String
  booker   User        @relation("Booker", fields: [bookerId], references: [id])

  spaceId        String?
  space          Space?        @relation("BookingSpace", fields: [spaceId], references: [id])
  sessionId      String?
  session        ClubSession?  @relation("BookingSession", fields: [sessionId], references: [id])
  classId        String?
  class          GroupClass?   @relation("BookingClass", fields: [classId], references: [id])
  coachServiceId String?
  coachService   CoachService? @relation("BookingCoachService", fields: [coachServiceId], references: [id])
  // مربی همراه (رزرو همراه مربی) یا مربی جلسه خصوصی
  coachId String?
  coach   CoachProfile? @relation("BookingCoach", fields: [coachId], references: [id])

  startAt      DateTime
  endAt        DateTime
  attendeeCount Int          @default(1)
  isOnline     Boolean       @default(false)
  status       BookingStatus @default(PENDING)
  // رزرو دوره‌ای: same group id for all occurrences
  recurringGroupId String?

  totalPrice     Decimal  @db.Decimal(12, 0)
  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])
  paidFromWallet Boolean  @default(false)
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])

  cancelledAt DateTime?
  cancelNote  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  attendees BookingAttendee[]
  refund    Refund?

  @@index([spaceId, startAt, endAt])
  @@index([coachId, startAt, endAt])
  @@index([sessionId, startAt])
  @@index([bookerId])
}

model BookingAttendee {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?   @relation(fields: [userId], references: [id])
  guestName String?

  @@index([bookingId])
}

// ─────────────────────────────────────────────
// Platform subscription (Gym4Me plans) — fully dynamic, admin-defined
// ─────────────────────────────────────────────

model PlatformPlan {
  id       String  @id @default(cuid())
  audience Role // ATHLETE | COACH | CLUB_OWNER
  name     String // رایگان، حرفه‌ای، پریمیوم، ...
  slug     String  @unique
  price    Decimal @db.Decimal(12, 0)
  periodDays Int   @default(30)
  // dynamic limits: {"maxStudents":20,"maxBranches":1,"maxStaff":5,"maxActivePrograms":10,"maxFileMb":100,"advancedReports":false,"commissionPercent":10,"canAdvertise":false}
  limits   Json
  features Json? // marketing feature list
  order    Int     @default(0)
  isActive Boolean @default(true)

  subscriptions PlatformSubscription[]
}

model PlatformSubscription {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      PlatformPlan @relation(fields: [planId], references: [id])
  startsAt  DateTime     @default(now())
  endsAt    DateTime
  status    String       @default("active") // active | expired | cancelled
  paymentId String?
  payment   Payment?     @relation(fields: [paymentId], references: [id])
  createdAt DateTime     @default(now())

  @@index([userId, status])
}

// ─────────────────────────────────────────────
// Club membership (sold by the club to athletes) — separate from platform plans
// ─────────────────────────────────────────────

enum ClubMembershipKind {
  DURATION // یک‌ماهه، سه‌ماهه، یک‌ساله
  SESSION_PACK // بسته ۱۰ جلسه‌ای
  ENTRY_COUNT // تعداد ورود
  UNLIMITED
}

model ClubMembershipPlan {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  name         String
  kind         ClubMembershipKind
  price        Decimal            @db.Decimal(12, 0)
  durationDays Int? // for DURATION / UNLIMITED validity window
  sessionCount Int? // for SESSION_PACK / ENTRY_COUNT
  // time window restriction e.g. only mornings: {"start":"06:00","end":"12:00"}
  timeWindow   Json?
  sportId      String? // sport-restricted membership
  sport        Sport?             @relation(fields: [sportId], references: [id])
  isFamily     Boolean            @default(false)
  isCorporate  Boolean            @default(false)
  maxMembers   Int                @default(1) // family/corporate seats
  isActive     Boolean            @default(true)

  // usable branches; empty = all branches of the club
  branchLinks ClubMembershipPlanBranch[]
  memberships ClubMembership[]
}

model ClubMembershipPlanBranch {
  planId   String
  plan     ClubMembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  branchId String
  branch   ClubBranch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([planId, branchId])
}

model ClubMembership {
  id        String             @id @default(cuid())
  planId    String
  plan      ClubMembershipPlan @relation(fields: [planId], references: [id])
  athleteId String
  athlete   AthleteProfile     @relation(fields: [athleteId], references: [id])
  branchId  String? // purchased-at branch
  branch    ClubBranch?        @relation(fields: [branchId], references: [id])

  validFrom         DateTime  @default(now())
  validTo           DateTime?
  remainingSessions Int?
  status            String    @default("active") // active | expired | frozen | cancelled
  paymentId         String?
  payment           Payment?  @relation(fields: [paymentId], references: [id])
  createdAt         DateTime  @default(now())

  checkIns MembershipCheckIn[]

  @@index([athleteId, status])
}

model MembershipCheckIn {
  id           String         @id @default(cuid())
  membershipId String
  membership   ClubMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  branchId     String
  branch       ClubBranch     @relation(fields: [branchId], references: [id])
  checkedInAt  DateTime       @default(now())
  withCoach    Boolean        @default(false)
}

// One-off entry ticket (بلیط)
model EntryTicket {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id])
  branchId  String
  branch    ClubBranch     @relation(fields: [branchId], references: [id])
  validOn   DateTime
  price     Decimal        @db.Decimal(12, 0)
  qrCode    String         @unique @default(cuid())
  status    String         @default("valid") // valid | used | expired | refunded
  paymentId String?
  payment   Payment?       @relation(fields: [paymentId], references: [id])
  usedAt    DateTime?
  createdAt DateTime       @default(now())
}

// ─────────────────────────────────────────────
// Training: exercise bank & programs
// ─────────────────────────────────────────────

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Exercise {
  id         String         @id @default(cuid())
  name       String
  sportId    String?
  sport      Sport?         @relation(fields: [sportId], references: [id])
  difficulty Difficulty     @default(BEGINNER)
  videoUrl   String?
  imageUrl   String?
  safetyTips String?
  commonMistakes String?
  instructions   String?
  // null → admin bank exercise; set → coach custom exercise
  creatorCoachId String?
  creatorCoach   CoachProfile?  @relation("ExerciseCreator", fields: [creatorCoachId], references: [id])
  // coach customs stay PENDING (visible only to that coach's students) until approved
  status     TaxonomyStatus @default(APPROVED)
  isActive   Boolean        @default(true)

  muscles      ExerciseMuscle[]
  equipment    ExerciseEquipment[]
  alternatives ExerciseAlternative[] @relation("ExerciseBase")
  alternativeOf ExerciseAlternative[] @relation("ExerciseAlt")
  workoutExercises WorkoutExercise[]
  personalRecords  PersonalRecord[]
  logEntries       WorkoutLogEntry[]
}

model ExerciseMuscle {
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscleId   String
  muscle     Muscle   @relation(fields: [muscleId], references: [id], onDelete: Cascade)
  isPrimary  Boolean  @default(true)

  @@id([exerciseId, muscleId])
}

model ExerciseEquipment {
  exerciseId  String
  exercise    Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   EquipmentItem @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([exerciseId, equipmentId])
}

model ExerciseAlternative {
  exerciseId    String
  exercise      Exercise @relation("ExerciseBase", fields: [exerciseId], references: [id], onDelete: Cascade)
  alternativeId String
  alternative   Exercise @relation("ExerciseAlt", fields: [alternativeId], references: [id], onDelete: Cascade)

  @@id([exerciseId, alternativeId])
}

// Program → Weeks → Days → Workout Sessions → Exercises
model Program {
  id        String          @id @default(cuid())
  coachId   String?
  coach     CoachProfile?   @relation("ProgramCoach", fields: [coachId], references: [id])
  athleteId String?
  athlete   AthleteProfile? @relation("ProgramAthlete", fields: [athleteId], references: [id])
  title     String
  goal      String?
  notes     String?
  status    String          @default("draft") // draft | active | completed | archived
  startDate DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  weeks ProgramWeek[]

  @@index([athleteId])
  @@index([coachId])
}

model ProgramWeek {
  id        String  @id @default(cuid())
  programId String
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekNo    Int
  notes     String?

  days ProgramDay[]

  @@unique([programId, weekNo])
}

model ProgramDay {
  id     String      @id @default(cuid())
  weekId String
  week   ProgramWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  dayNo  Int
  title  String?
  isRest Boolean     @default(false)

  sessions WorkoutSession[]

  @@unique([weekId, dayNo])
}

model WorkoutSession {
  id     String     @id @default(cuid())
  dayId  String
  day    ProgramDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  title  String
  order  Int        @default(0)
  notes  String?

  exercises WorkoutExercise[]
}

model WorkoutExercise {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  order      Int            @default(0)

  sets         Int?
  reps         String? // "10" or "8-12"
  weightKg     Float?
  durationSec  Int?
  restSec      Int?
  tempo        String? // e.g. "3-1-2"
  instructions String?
}

model SupplementPlan {
  id        String          @id @default(cuid())
  coachId   String?
  coach     CoachProfile?   @relation(fields: [coachId], references: [id])
  athleteId String
  athlete   AthleteProfile  @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  title     String
  // [{"name":"کراتین","dose":"5g","timing":"بعد تمرین","notes":""}]
  items     Json
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
}

// Athlete's performed-workout log
model WorkoutLog {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  performedAt DateTime     @default(now())
  title     String?
  notes     String?
  energyLevel Int? // 1-5
  painNote  String?

  entries WorkoutLogEntry[]

  @@index([athleteId, performedAt])
}

model WorkoutLogEntry {
  id         String     @id @default(cuid())
  logId      String
  log        WorkoutLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  exerciseId String?
  exercise   Exercise?  @relation(fields: [exerciseId], references: [id])
  freeText   String?
  sets       Int?
  reps       String?
  weightKg   Float?
  durationSec Int?
}

// ─────────────────────────────────────────────
// Progress tracking
// ─────────────────────────────────────────────

enum Privacy {
  PUBLIC
  FOLLOWERS
  COACH_ONLY
  PRIVATE
}

model MetricEntry {
  id           String         @id @default(cuid())
  athleteId    String
  athlete      AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  metricTypeId String
  metricType   MetricType     @relation(fields: [metricTypeId], references: [id])
  value        Float?
  secondValue  Float? // e.g. diastolic for blood pressure
  textValue    String? // e.g. mood
  recordedAt   DateTime       @default(now())
  note         String?

  @@index([athleteId, metricTypeId, recordedAt])
}

model ProgressPhoto {
  id        String         @id @default(cuid())
  athleteId String
  athlete   AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  imageUrl  String
  takenAt   DateTime       @default(now())
  privacy   Privacy        @default(PRIVATE)
  note      String?
}

model PersonalRecord {
  id         String         @id @default(cuid())
  athleteId  String
  athlete    AthleteProfile @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id])
  value      Float
  unit       String // kg | sec | m | reps
  recordedAt DateTime       @default(now())

  @@index([athleteId, exerciseId])
}

// ─────────────────────────────────────────────
// Social network
// ─────────────────────────────────────────────

model Follow {
  id              String  @id @default(cuid())
  followerId      String
  follower        User    @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followingUserId String?
  followingUser   User?   @relation("FollowingUser", fields: [followingUserId], references: [id], onDelete: Cascade)
  followingClubId String?
  followingClub   Club?   @relation("FollowingClub", fields: [followingClubId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([followerId, followingUserId])
  @@unique([followerId, followingClubId])
}

enum PostKind {
  POST
  ACHIEVEMENT
  WORKOUT
}

model Post {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind      PostKind @default(POST)
  content   String?
  media     Json? // [{"type":"image","url":"..."}]
  privacy   Privacy  @default(PUBLIC)
  isHidden  Boolean  @default(false) // hidden by moderation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    PostLike[]
  comments PostComment[]
  saves    SavedPost[]

  @@index([authorId, createdAt])
}

model PostLike {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SavedPost {
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([postId, userId])
}

model ContentReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id])
  targetType String // post | comment | user | club | review
  targetId   String
  reason     String
  status     String   @default("open") // open | reviewed | dismissed | actioned
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
}

model Review {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  targetType String // club | coach | class
  clubId     String?
  club       Club?    @relation("ReviewClub", fields: [clubId], references: [id])
  targetId   String // generic target id (coachProfileId / classId)
  rating     Int // 1..5
  comment    String?
  status     String   @default("published") // published | pending | hidden
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id])
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id])
  body        String
  kind        String   @default("message") // message | reminder | feedback
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, readAt])
}

// ─────────────────────────────────────────────
// Financial
// ─────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Wallet {
  id      String  @id @default(cuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance Decimal @default(0) @db.Decimal(14, 0)

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(14, 0) // positive=credit, negative=debit
  kind      String // topup | booking | refund | settlement | adjustment
  refId     String? // related payment/booking id
  note      String?
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

model Payment {
  id            String        @id @default(cuid())
  payerId       String
  payer         User          @relation(fields: [payerId], references: [id])
  amount        Decimal       @db.Decimal(14, 0)
  method        String // gateway | wallet | mixed
  gateway       String? // zarinpal | ...
  gatewayRef    String?
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  // تقسیم تراکنش: مبلغ − تخفیف − مالیات − سهم ارائه‌دهنده − کمیسیون − کارمزد درگاه = قابل تسویه
  discountAmount  Decimal @default(0) @db.Decimal(14, 0)
  taxAmount       Decimal @default(0) @db.Decimal(14, 0)
  providerShare   Decimal @default(0) @db.Decimal(14, 0)
  platformFee     Decimal @default(0) @db.Decimal(14, 0)
  gatewayFee      Decimal @default(0) @db.Decimal(14, 0)
  netSettleAmount Decimal @default(0) @db.Decimal(14, 0)

  bookings              Booking[]
  clubMemberships       ClubMembership[]
  platformSubscriptions PlatformSubscription[]
  entryTickets          EntryTicket[]
  invoice               Invoice?
  refunds               Refund[]
}

model Invoice {
  id        String   @id @default(cuid())
  paymentId String   @unique
  payment   Payment  @relation(fields: [paymentId], references: [id])
  number    String   @unique
  issuedAt  DateTime @default(now())
  lines     Json // [{"title":"...","qty":1,"unitPrice":...,"total":...}]
}

model Refund {
  id        String              @id @default(cuid())
  paymentId String
  payment   Payment             @relation(fields: [paymentId], references: [id])
  bookingId String?             @unique
  booking   Booking?            @relation(fields: [bookingId], references: [id])
  amount    Decimal             @db.Decimal(14, 0)
  reasonId  String?
  reason    CancellationReason? @relation(fields: [reasonId], references: [id])
  note      String?
  status    String              @default("pending") // pending | approved | rejected | paid
  createdAt DateTime            @default(now())
  resolvedAt DateTime?
}

// Admin-configurable commission rules
model CommissionRule {
  id       String   @id @default(cuid())
  scope    String // space_booking | coach_session | club_membership | group_class | ticket
  clubId   String? // override for a specific club
  coachId  String? // override for a specific coach
  percent  Float?
  fixedFee Decimal? @db.Decimal(12, 0)
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Settlement {
  id        String        @id @default(cuid())
  clubId    String?
  club      Club?         @relation("SettlementClub", fields: [clubId], references: [id])
  coachId   String?
  coach     CoachProfile? @relation("SettlementCoach", fields: [coachId], references: [id])
  periodFrom DateTime
  periodTo   DateTime
  grossAmount Decimal @db.Decimal(14, 0)
  commission  Decimal @db.Decimal(14, 0)
  netAmount   Decimal @db.Decimal(14, 0)
  iban        String?
  status      String  @default("pending") // pending | paid | disputed
  paidAt      DateTime?
  createdAt   DateTime @default(now())
}

model DiscountCode {
  id           String    @id @default(cuid())
  code         String    @unique
  clubId       String? // club-scoped; null = platform-wide (admin)
  club         Club?     @relation(fields: [clubId], references: [id])
  percent      Float?
  fixedAmount  Decimal?  @db.Decimal(12, 0)
  maxUses      Int?
  usedCount    Int       @default(0)
  maxUsesPerUser Int     @default(1)
  startsAt     DateTime?
  endsAt       DateTime?
  isActive     Boolean   @default(true)

  bookings Booking[]
}

// ─────────────────────────────────────────────
// Content, notifications, admin ops
// ─────────────────────────────────────────────

model NotificationTemplate {
  id       String  @id @default(cuid())
  key      String  @unique // booking_confirmed, ...
  title    String
  body     String // supports {{placeholders}}
  channels String[] // push | sms | email | inapp
  isActive Boolean @default(true)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  kind      String   @default("general")
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model StaticPage {
  id        String   @id @default(cuid())
  slug      String   @unique // about, terms, privacy
  title     String
  body      String
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  category String?
  order    Int     @default(0)
  isActive Boolean @default(true)
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  subject   String
  body      String
  status    String   @default("open") // open | in_progress | resolved | closed
  createdAt DateTime @default(now())
  resolvedAt DateTime?
}

// Full change history for important entities
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String // create | update | delete | login | impersonate | ...
  entity    String // model name
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  // set when action happened during admin impersonation
  impersonationId String?
  impersonation   ImpersonationSession? @relation(fields: [impersonationId], references: [id])
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}

model ImpersonationSession {
  id           String    @id @default(cuid())
  adminId      String
  admin        User      @relation("ImpersonatorAdmin", fields: [adminId], references: [id])
  targetUserId String
  target       User      @relation("ImpersonationTarget", fields: [targetUserId], references: [id])
  reason       String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  auditLogs AuditLog[]
}
