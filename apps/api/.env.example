# Runtime and data
NODE_ENV="development"
PORT="8088"
# Transactions are required for booking, finance, membership, and check-in.
# `npm run docker:up` exposes the required single-node replica set on 27018.
MONGODB_URI="mongodb://127.0.0.1:27018/gym4me?replicaSet=rs0&directConnection=true"
REDIS_URL="redis://localhost:6380"
UPLOAD_DIR="./uploads"
# local | s3 — s3 needs the S3_* block below (works with MinIO/Arvan too).
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public API origin without /api/v1; used to build mock-payment checkout URLs.
API_BASE_URL="http://localhost:8088"
# Custom URL scheme registered by the Capacitor iOS/Android shells.
MOBILE_DEEP_LINK_SCHEME="com.gym4me.app"

# Local diagnostics. DEBUG_MODE=true is required to use mock SMS.
DEBUG_MODE="true"
ENABLE_SWAGGER="true"
# Comma-separated allowlist in production. Empty + non-production = reflective origins.
CORS_ORIGINS=""

# openssl rand -base64 48 — must be ≥32 chars and distinct
JWT_ACCESS_SECRET=""
JWT_PASSWORD_RESET_SECRET=""
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL_DAYS="30"

# Booking and referral defaults
BOOKING_PAYMENT_TTL_MINUTES="15"
REFERRAL_REWARD_AMOUNT="50000"

# mock | kavenegar — DEBUG_MODE=false always selects Kavenegar.
SMS_PROVIDER="mock"
KAVENEGAR_API_KEY=""
# Create this verify template in Kavenegar panel (token = OTP code):
# کد تأیید جیم‌فورمی: %token
KAVENEGAR_OTP_TEMPLATE="verify"
KAVENEGAR_INVITE_TEMPLATE=""
KAVENEGAR_SENDER=""

# mock | zarinpal
PAYMENT_PROVIDER="mock"
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="true"

# HMAC key for short-lived, device-bound offline reception snapshots (>=32 chars).
OFFLINE_CHECKIN_SIGNING_SECRET=""

# mock | fcm
PUSH_PROVIDER="mock"
# Inline service-account JSON or a path to its JSON file.
FCM_SERVICE_ACCOUNT=""

# mock | finnotech (Shahkar phone ↔ national ID match via Finnotech aggregator)
KYC_PROVIDER="mock"
FINNOTECH_BASE_URL="https://api.finnotech.ir"
FINNOTECH_CLIENT_ID=""
FINNOTECH_CLIENT_SECRET=""
FINNOTECH_CLIENT_NATIONAL_ID=""

# Public support details returned by GET /api/v1/support/contact.
SUPPORT_PHONE=""
SUPPORT_EMAIL=""
SUPPORT_TELEGRAM=""
SUPPORT_WORKING_HOURS=""

# Demo seeding. Production additionally requires ALLOW_DEMO_SEED=true.
ALLOW_DEMO_SEED="false"
SEED_DEMO_PASSWORD=""
