{
  "name": "@gym4me/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./database": {
      "types": "./src/database/index.ts",
      "default": "./dist/database/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "build:database": "tsc -p tsconfig.database.json",
    "start": "node dist/main.js",
    "bootstrap:admin": "node dist/cli/bootstrap-admin.js",
    "db:indexes": "tsx src/database/indexes.ts",
    "db:seed": "tsx src/database/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "latest",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-fastify": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "latest",
    "dotenv": "latest",
    "mongoose": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "latest"
  }
}
