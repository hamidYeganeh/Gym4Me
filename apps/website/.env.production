# Loaded by Next.js on `next build`.
# Docker/CI can still override via build args / compose.
NEXT_PUBLIC_API_BASE_URL=https://api.gym4me.ir/api/v1
NEXT_PUBLIC_SITE_URL=https://gym4me.ir
# Prefer the public API URL unless the container network exposes an internal host.
INTERNAL_API_BASE_URL=https://api.gym4me.ir/api/v1
