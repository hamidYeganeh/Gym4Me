# Copy to `.env.local` for machine-specific overrides (gitignored).
# Takes precedence over `.env` and `.env.[mode]` for matching keys.
#
# Example: talk to API on this machine instead of the LAN host.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8088/api/v1
# INTERNAL_API_BASE_URL=http://localhost:8088/api/v1
