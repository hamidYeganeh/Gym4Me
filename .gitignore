# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnpm-store
.pnp
.pnp.js

# Local env files / secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local

# Frontend apps may commit public mode defaults (no secrets).
!apps/admin/.env.development
!apps/admin/.env.production
!apps/mobile/.env.development
!apps/mobile/.env.production
!apps/website/.env.development
!apps/website/.env.production
!apps/admin/.env.local.example
!apps/mobile/.env.local.example
!apps/website/.env.local.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
artifacts/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma generated client
apps/api/src/generated/

# Misc
.DS_Store
*.pem
*.jks
*.keystore
!**/debug.keystore
