# Runtime mode and public origins (switch to https:// after DNS + TLS).
NODE_ENV=production
WEBSITE_URL=http://gym4me.ir
APP_URL=http://app.gym4me.ir
ADMIN_URL=http://admin.gym4me.ir
API_PUBLIC_URL=http://api.gym4me.ir
CORS_ALLOWED_ORIGINS=http://gym4me.ir,http://www.gym4me.ir,http://app.gym4me.ir,http://admin.gym4me.ir

# MongoDB — production uses Atlas (required).
# Atlas → Database → Connect → Drivers → copy the SRV URI, then set DB name + password.
# Example:
#   mongodb+srv://USER:PASSWORD@CLUSTER.xxxxx.mongodb.net/gym4me?retryWrites=true&w=majority
# Allowlist the VPS public IP (or 0.0.0.0/0 temporarily) under Network Access.
MONGODB_URI=
# Optional self-hosted Mongo instead of Atlas:
#   docker compose ... --profile local-mongo up -d
#   MONGODB_URI=mongodb://mongo:27017/gym4me?replicaSet=rs0

# Generate each value separately with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_PASSWORD_RESET_SECRET=
OFFLINE_CHECKIN_SIGNING_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
METRICS_TOKEN=

# Booking and referral policy.
BOOKING_PAYMENT_TTL_MINUTES=15
BOOKING_COACH_APPROVAL_TTL_MINUTES=1440
REFERRAL_REWARD_AMOUNT=50000

SWAGGER_ENABLED=false
DEBUG_MODE=false

# SMS is required because production mode intentionally rejects mock SMS.
OTP_PROVIDER=kavenegar
# The account must be activated for public sending; test accounts return status 501
# and can only send to the Kavenegar account owner's phone.
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=gym4meotp
KAVENEGAR_TEMPLATE_BOOKING_CONFIRMED=gym4mebookingconfirmed
KAVENEGAR_TEMPLATE_BOOKING_REMINDER=gym4mebookingreminder
KAVENEGAR_TEMPLATE_BOOKING_CANCELLED=gym4mebookingcancelled
KAVENEGAR_TEMPLATE_BOOKING_RESCHEDULED=gym4mebookingrescheduled
KAVENEGAR_TEMPLATE_WAITLIST_AVAILABLE=gym4mewaitlist
KAVENEGAR_TEMPLATE_PAYMENT_FAILED=gym4mepaymentfailed
KAVENEGAR_SENDER=

# P0/P1 payment is intentionally the built-in approve/cancel test gateway.
# Production Worker boots fail-closed unless SMS and Push providers are configured.
NOTIFICATION_PROVIDER=kavenegar
PUSH_PROVIDER=direct
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Preferred for a self-hosted worker: keep the JSON outside the image and mount it read-only.
FCM_SERVICE_ACCOUNT_FILE_HOST=./apps/worker/.secrets/firebase-push-service-account.json
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.gym4me.app
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production
APNS_ENABLED=false
# api_ir | mock | finnotech (Shahkar via selected provider)
KYC_PROVIDER=api_ir
API_IR_BASE_URL=https://s.api.ir
API_IR_API_KEY=
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_CLIENT_NATIONAL_ID=

SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_WORKING_HOURS=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
