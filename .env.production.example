# Public origins (switch to https:// after DNS + TLS).
WEBSITE_URL=http://gym4me.ir
APP_URL=http://app.gym4me.ir
ADMIN_URL=http://admin.gym4me.ir
API_PUBLIC_URL=http://api.gym4me.ir
CORS_ORIGINS=http://gym4me.ir,http://www.gym4me.ir,http://app.gym4me.ir,http://admin.gym4me.ir

# Generate each value separately with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_PASSWORD_RESET_SECRET=
JWT_ACCESS_TTL=900s
JWT_REFRESH_TTL_DAYS=30

ENABLE_SWAGGER=false
DEBUG_MODE=false

# SMS is required because production mode intentionally rejects mock SMS.
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=verify
KAVENEGAR_INVITE_TEMPLATE=
KAVENEGAR_SENDER=

# Replace mock payment/push/KYC providers before enabling those features.
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
PUSH_PROVIDER=mock
FCM_SERVICE_ACCOUNT=
KYC_PROVIDER=mock
FINNOTECH_BASE_URL=https://api.finnotech.ir
FINNOTECH_CLIENT_ID=
FINNOTECH_CLIENT_SECRET=
FINNOTECH_CLIENT_NATIONAL_ID=

SUPPORT_PHONE=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_WORKING_HOURS=
